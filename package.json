{
  "name": "job-applications-tracker",
  "version": "0.1.0",
  "description": "Track every job application: which role, which CV you sent, and what came back. A local tracker with zero dependencies and no telemetry.",
  "keywords": [
    "job-application-tracker",
    "job-tracker",
    "application-tracker",
    "job-search",
    "job-application",
    "job-apply",
    "ats",
    "resume",
    "cv",
    "career",
    "job-hunt",
    "cli",
    "agent-skills",
    "claude-code",
    "privacy"
  ],
  "license": "MIT",
  "author": "Alok Rajasukumaran (https://alokraj68.in)",
  "homepage": "https://alokraj68.in/job-applications-tracker",
  "bugs": {
    "url": "https://github.com/alokraj68/job-applications-tracker/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/alokraj68"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/alokraj68"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alokraj68/job-applications-tracker.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "job-applications-tracker": "bin/job-applications-tracker.mjs",
    "jobtrack": "bin/job-applications-tracker.mjs"
  },
  "exports": {
    ".": "./src/store.mjs",
    "./store": "./src/store.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@alokraj68/plainspoken": ">=1.1.0",
    "@alokraj68/ats-resume": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "@alokraj68/plainspoken": {
      "optional": true
    },
    "@alokraj68/ats-resume": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/run.mjs",
    "lint:prose": "npx --yes @alokraj68/plainspoken README.md skills/job-apply/SKILL.md",
    "ci": "npm test && npm run lint:prose && npm pack --dry-run"
  }
}
